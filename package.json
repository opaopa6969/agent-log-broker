{
  "name": "@unlaxer/agent-log-broker",
  "version": "0.1.0",
  "description": "Central log broker for AskOS workspace ecosystem - fan-out agent logs to consumers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "log-broker",
    "askos",
    "fan-out"
  ],
  "author": "unlaxer",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@unlaxer/tramli": "^3.6.1"
  }
}
